{
  "manifest_version": 3,
  "key": "",
  "name": "知乎提问助手",
  "version": "2.2.0",
  "minimum_chrome_version": "110",
  "description": "用自己的 API Key 或知乎直答，将网页转为知乎提问草稿。可选概括或已加载原文，支持自动填写、话题匹配、拖动与网站过滤，无需本地服务。",
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": ["https://api.openai.com/*", "https://developer.zhihu.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "知乎提问助手",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhihu.com/*"],
      "js": ["uiTheme.js", "siteAccess.js", "draggable.js", "zhihuComposer.js", "zhihuTopics.js", "zhihuDraftLifecycle.js", "zhihuDraft.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["uiTheme.js", "siteAccess.js", "draggable.js", "pageText.js", "contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
